<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.ai.plug</groupId>
    <artifactId>server2mcp-parent</artifactId>
    <version>1.1.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>server2mcp-parent</name>

    <description>Spring Boot Starter: Auto-convert existing REST APIs (@RestController) to MCP Server with zero/low-code.</description>
    <url>https://github.com/TheEterna/api2mcp4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>han</id>
            <name>Han</name>
            <email>han@xiaohan.chat</email>
            <url>https://github.com/TheEterna</url>
            <organization>TheEterna</organization>
            <organizationUrl>https://github.com/TheEterna</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/TheEterna/api2mcp4j.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/TheEterna/api2mcp4j.git</developerConnection>
        <url>https://github.com/TheEterna/api2mcp4j</url>
        <tag>master</tag>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>17</java.version>
        <project.version>1.0.0</project.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <javaparser.version>3.25.5</javaparser.version>
        <victools.module.swagger1-5.version>5.0.0</victools.module.swagger1-5.version>
        <swagger1-5.annotations.version>1.5.20</swagger1-5.annotations.version>
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
        <jakarta.validation-api.version>3.1.0</jakarta.validation-api.version>
        <javax.validation-api.version>2.0.1.Final</javax.validation-api.version>
        <!-- Sonatype requires these. Centralised so all child poms inherit. -->
        <gpg.skip>true</gpg.skip>
    </properties>


    <!--
      依赖已全部落到 Maven Central 正式版（Spring AI 2.0.0 / MCP SDK 2.0.0 / Spring Boot 4.1.0），
      不再需要 Spring milestone / snapshot 源。原快照源已失效，保留只会拖慢构建。
      变更日：2026-07-30
    -->

    <modules>
        <module>server2mcp-common</module>
        <module>server2mcp-core</module>
        <module>server2mcp-autoconfigure</module>
        <module>server2mcp-spring-boot-starters/server2mcp-starter-webmvc</module>
        <module>server2mcp-spring-boot-starters/server2mcp-starter-webflux</module>

    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>



            <!--
              原 com.logaritex.mcp:mcp-annotations（0.2.0-PRIVATE）已随 Spring AI 2.0
              被吸收进核心，成为 org.springframework.ai:spring-ai-mcp-annotations，
              由 spring-ai-bom 统一管理版本，无需单独声明。移除日：2026-07-30
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- javadoc库 -->
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>

            <!-- victools 的 swagger1.5 插件 -->
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-swagger-1.5</artifactId>
                <version>${victools.module.swagger1-5.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-jakarta-validation</artifactId>
                <version>${victools.module.swagger1-5.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-javax-validation</artifactId>
                <version>${victools.module.swagger1-5.version}</version>
            </dependency>

            <dependency>
                <groupId>io.swagger</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger1-5.annotations.version}</version>
            </dependency>

            <!-- javax 的校验注解 -->
            <dependency>
                <groupId>javax.validation</groupId>
                <artifactId>validation-api</artifactId>
                <scope>compile</scope>
                <version>${javax.validation-api.version}</version>
            </dependency>

            <!-- jakarta 的校验注解 -->
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <scope>compile</scope>
                <version>${jakarta.validation-api.version}</version>
            </dependency>
            <!-- 覆盖原始低稳定版本mcp -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp-sdk.version}</version>
            </dependency>

            <dependency>
                <groupId>com.ai.plug</groupId>
                <artifactId>server2mcp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ai.plug</groupId>
                <artifactId>server2mcp-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ai.plug</groupId>
                <artifactId>server2mcp-common</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>


    </dependencyManagement>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:deprecation</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Source jar (Sonatype requires sources alongside binaries) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc jar (Sonatype requires it) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <source>${java.version}</source>
                </configuration>
            </plugin>

            <!-- GPG sign every artifact. Skip by default (`-Dgpg.skip=false`
                 to enable). One secret (Sonatype token) plus one env var
                 (GPG passphrase) is enough. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals><goal>sign</goal></goals>
                        <configuration>
                            <skip>${gpg.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Sonatype staging deploy. Use `-Psonatype-oss-release` to
                 enable (profile lives in this file). -->
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <version>1.7.0</version>
                <extensions>true</extensions>
                <configuration>
                    <serverId>ossrh</serverId>
                    <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                    <autoReleaseAfterClose>true</autoReleaseAfterClose>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Sonatype OSSRH release. Activate with `-Psonatype-oss-release`.
             Required env vars:
               SONATYPE_USERNAME  — your sonatype.org user
               SONATYPE_PASSWORD  — your sonatype.org token
               GPG_PASSPHRASE     — the passphrase for your GPG key
             Before first use: register the GPG public key on a public
             keyserver (e.g. keyserver.ubuntu.com) and verify your
             ownership of com.ai.plug groupId via JIRA. -->
        <profile>
            <id>sonatype-oss-release</id>
            <properties>
                <gpg.skip>false</gpg.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>